[Unit]
Description=Install the newest release of BabyTrails
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=babytrails-deploy
Group=babytrails-deploy
Environment=SITE_REPO=tbutman/babytrails
Environment=SITE_ROOT=/srv/babytrails
ExecStart=/usr/local/bin/trails-deploy.sh
# Hardening: the script only needs network access and write access to the app's directory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/babytrails
PrivateTmp=true
ProtectHome=true
